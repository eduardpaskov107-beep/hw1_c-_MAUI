# ============================================================
# .NET / MAUI — стандартный .gitignore
# ============================================================

# --- Скомпилированный код и промежуточные файлы сборки ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
[Ll]og/
[Ll]ogs/

# --- Visual Studio ---
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# --- Rider / JetBrains ---
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# --- VS Code ---
.vscode/

# --- Mac ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- MAUI: артефакты платформ ---
# Mac Catalyst
*.app/
*.app.dSYM/
*.ipa
*.dSYM/
*.dSYM.zip

# Android
*.apk
*.aab
*.ap_
*.dex
*.class
.cxx/
.externalNativeBuild/
.gradle/

# iOS
*.ipa
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# Windows
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.pfx
*.snk

# --- NuGet ---
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# --- Тестовые и временные файлы ---
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# --- Кэш сборки/анализа ---
*.cache
*.pidb
*.svclog
*.scc
*.bak
*.tmp
*.temp
*.swp
*~

# --- Секреты и локальные настройки (на всякий случай) ---
# Раскомментируй, если хранишь ключи локально:
# appsettings.local.json
# *.secrets.json
# .env
# .env.local